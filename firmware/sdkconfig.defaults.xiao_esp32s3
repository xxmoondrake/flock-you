CONFIG_FY_BOARD_XIAO_ESP32S3=y

# Console on the native USB Serial/JTAG port. UART0 (D6/D7) stays free for
# the GPS receiver.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# No display to show a per-device passkey: the Wi-Fi dashboard uses a shared
# one. Change it for your own builds.
CONFIG_FY_DASHBOARD_PASSKEY="fy-dashboard"
