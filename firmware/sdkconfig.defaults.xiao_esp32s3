CONFIG_FY_BOARD_XIAO_ESP32S3=y

# Console on the native USB Serial/JTAG port. UART0 (D6/D7) stays free for
# the GPS receiver.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# USB dashboard (fy_usb), the XIAO's only dashboard, started at boot: a
# composite USB device with a CDC-ACM console and a CDC-NCM network
# interface. Early boot logs still go to USB Serial/JTAG; the console moves
# to the CDC-ACM port once the USB device starts.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Detector"
CONFIG_TINYUSB_DESC_CDC_STRING="Detector console"
