CONFIG_FY_BOARD_HELTEC_V43=y

# The V4.3 USB-C port is native USB Serial/JTAG, so
# the console uses it and UART0 (GPIO43/44, header J2) stays undriven.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Optional USB dashboard (fy_usb), started from the Device menu: a composite
# USB device with a CDC-ACM console and a CDC-NCM network interface. Until
# then the port stays USB Serial/JTAG.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Limier"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Limier"
CONFIG_TINYUSB_DESC_CDC_STRING="Limier console"
