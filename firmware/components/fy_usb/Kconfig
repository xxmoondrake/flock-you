menu "Detector USB dashboard"

    config FY_USB_DASHBOARD
        bool "Offer the dashboard over USB networking, with a USB console"
        depends on TINYUSB_NET_MODE_NCM && TINYUSB_CDC_ENABLED
        default y
        help
            Lets the native USB port become a composite device: a CDC-ACM
            serial port that carries the console, and a CDC-NCM network
            interface at 192.168.7.1 serving the dashboard. Only offered
            when the TinyUSB NCM and CDC options are enabled, which both
            boards' sdkconfig defaults do.

    config FY_USB_DASHBOARD_AT_BOOT
        bool "Start the USB dashboard at boot"
        depends on FY_USB_DASHBOARD
        default y if FY_BOARD_XIAO_ESP32S3
        default n
        help
            On: the USB dashboard runs from boot (the XIAO's only
            dashboard). Off: it is started from the Device menu (the
            Heltec), and the port keeps the USB Serial/JTAG console until
            then.

endmenu
